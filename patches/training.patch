+@dataclass
+class QueryMicrobatchGroup:
+    """Sequential query chunks from one already-augmented image datapoint."""
+
+    chunks: List[dict]
+    original_query_count: int
+
+
+def collate_fn_api_with_query_microbatching(
+    batch,
+    max_queries_per_microbatch,
+    max_outputs_per_microbatch,
+    dict_key,
+    with_seg_masks=False,
+    input_points_embedding_dim=257,
+    repeats: int = 0,
+    load_image_in_fp16: bool = False,
+):
+    """Split queries only after dataset transforms have run once.
+
+    This is intentionally restricted to local batch one. Each collated chunk
+    contains only targets referenced by its query slice, while sharing the
+    same already-augmented image tensor. The trainer accumulates all chunks
+    into one optimizer step using full-query-batch normalization.
+    """
+    assert len(batch) == 1, "per-image query microbatching requires local batch 1"
+    assert max_queries_per_microbatch >= 1
+    assert max_outputs_per_microbatch >= 1
+    datapoint = batch[0]
+    queries = datapoint.find_queries
+    assert queries, "datapoint has no find queries"
+    query_slices = []
+    current = []
+    current_outputs = 0
+    for query in queries:
+        n_outputs = len(query.object_ids_output)
+        # A single query is indivisible. The training view guarantees it does
+        # not exceed the upstream per-query cap (200).
+        assert n_outputs <= max_outputs_per_microbatch, (
+            f"single query has {n_outputs} outputs, above microbatch budget "
+            f"{max_outputs_per_microbatch}"
+        )
+        if current and (
+            len(current) >= max_queries_per_microbatch
+            or current_outputs + n_outputs > max_outputs_per_microbatch
+        ):
+            query_slices.append(current)
+            current = []
+            current_outputs = 0
+        current.append(query)
+        current_outputs += n_outputs
+    if current:
+        query_slices.append(current)
+
+    chunks = []
+    for query_slice in query_slices:
+        micro_datapoint = replace(
+            datapoint,
+            find_queries=query_slice,
+        )
+        chunks.append(
+            collate_fn_api(
+                [micro_datapoint],
+                dict_key,
+                with_seg_masks,
+                input_points_embedding_dim,
+                repeats,
+                load_image_in_fp16,
+            )
+        )
+    return QueryMicrobatchGroup(
+        chunks=chunks,
+        original_query_count=len(queries),
+    )
+
